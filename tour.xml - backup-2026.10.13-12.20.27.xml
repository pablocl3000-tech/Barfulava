	<scene name="scene_escenario" title="escenario" onstart="" thumburl="panos/escenario.tiles/thumb.jpg" lat="" lng="" alt="" heading="">
		
		<control bouncinglimits="calc:image.cube ? true : false" />

		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="120" maxpixelzoom="2.0" fovmin="70" fovmax="140" limitview="auto" />

		<preview url="panos/escenario.tiles/preview.jpg" />

		<image>
			<cube url="panos/escenario.tiles/%s/l%l/%v/l%l_%s_%v_%h.jpg" multires="512,576" />
		</image>
<!-- Hotspot en el espacio 3D (dentro de la etiqueta <scene>) -->
<hotspot name="hotspot_video_1"
         url="recursos/1.png"
         ath="0.0" 
         atv="0.0"
         distorted="true"
         scale="1.0"
         onclick="mostrar_video_popup();"
         />

<!-- Acción modular a nivel raíz (fuera de las escenas, debajo de <krpano>) -->
<action name="mostrar_video_popup" scope="local">
    <!-- 1. Crea la capa contenedora para la ventana emergente -->
    addlayer(popup_video);
    
    <!-- 2. Asigna el plugin videoplayer oficial de krpano -->
    set(layer[popup_video].url, '%VIEWER%/plugins/videoplayer.js');
    set(layer[popup_video].videourl, 'recursos/video1.mp4');
    
    <!-- 3. Dimensionamiento y centrado en el visor 2D -->
    set(layer[popup_video].align, 'center');
    set(layer[popup_video].edge, 'center');
    set(layer[popup_video].width, '70%');
    set(layer[popup_video].height, 'prop');
    
    <!-- 4. Parámetros de reproducción -->
    set(layer[popup_video].pausedonstart, false);
    set(layer[popup_video].loop, false);
    set(layer[popup_video].volume, 1.0);
    
    <!-- 5. Destruye la capa al hacer clic sobre el video -->
    set(layer[popup_video].onclick, 'removelayer(popup_video);');
</action>

